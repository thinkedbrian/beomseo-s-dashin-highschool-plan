rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여넣고 "게시"를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 사람은 자기 폴더(users/자기UID) 안만 읽고 쓸 수 있습니다.
    // 다른 사람 폴더는 물론, 로그인하지 않은 사람은 아무것도 읽거나 쓸 수 없습니다.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 그 밖의 모든 경로는 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── 나만 쓰게 완전히 잠그고 싶다면 ──────────────────────────────
// 위 users 규칙을 아래로 바꾸세요. 'XXXX' 자리에는
// Firebase 콘솔 → Authentication → Users 에 보이는 내 "사용자 UID"를 넣습니다.
//
//     match /users/{uid}/{document=**} {
//       allow read, write: if request.auth != null
//                          && request.auth.uid == uid
//                          && uid == 'XXXX';
//     }
//
// 이렇게 하면 다른 Google 계정으로 로그인해도 아무것도 못 합니다.
